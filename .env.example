# weibo-scraper — copy to `.env` (same directory) and fill in what you need.
#
#   cp .env.example .env
#   python3 env_config.py        # prints what was picked up, WITHOUT secrets
#
# Precedence, highest first:
#   an explicit CLI flag  ->  an exported environment variable  ->  .env  ->  default
#
# A `.env` never overrides something you typed, and never clobbers a variable
# already exported by CI, direnv or your shell profile.
#
# `.env` is gitignored, and so is every variant of the name (`.env.bak`,
# `.env.local`, `.env.save`). That is not belt-and-braces: a sibling repo in
# this family had an untracked `.env.bak` holding a live key sitting in a
# PUBLIC repository, one `git add -A` from publication.
#
# Everything below is OPTIONAL. Read that literally — the three modes this
# repo ships need no key, no proxy and no account. Measured 2026-09-21 from
# a datacenter address in Finland with an empty `.env`: the hot feed, a
# user's posts and a post's comments all returned data, and 100 requests in
# 83 seconds drew zero refusals.


# --- 2Captcha key ----------------------------------------------------------
# One key, four separately-billed products: captcha solving, the Scraping
# Browser API, proxies and fingerprints.
#
# Nothing in this repo needs it today. No challenge was observed on any route
# it reads (5 captures, 0 widgets), so `--solve-captcha` is expected never to
# fire. It is wired because Weibo HAS a captcha configured on its login page,
# which means one appearing on a scraping route later is a change in the site
# rather than an impossibility.
TWOCAPTCHA_KEY=your_2captcha_api_key_here


# --- Scraping Browser API endpoint -----------------------------------------
# The SHAPE is documented; a working endpoint is deliberately not pasted here.
# A profile's credentials live about a day, so any example that worked would
# be stale by tomorrow and would fail with an auth error a long way from its
# cause.
#
#   ws://{login}-zone-scraping_browser-country-{cc}-pid-{profileId}:{password}@cb.2captcha.com:9222
#
# `country-` picks the exit country. `pid-` is a profile with persistent
# cookies and allows ONE live connection, so reuse pids rather than minting
# one per run.
#
# Note for the Selenium engine: it CANNOT use an authenticated endpoint.
# chromedriver's `debuggerAddress` takes a bare host:port with nowhere to put
# a password, while Playwright and pyppeteer authenticate on the WebSocket
# upgrade. Use playwright_scraper.py for this.
WEIBO_CDP_ENDPOINT=ws://{login}-zone-scraping_browser-country-us-pid-{profileId}:{password}@cb.2captcha.com:9222


# --- Proxy -----------------------------------------------------------------
# A single proxy URL. For a rotating pool use `--proxy-file` instead.
#
#   http://{user}:{password}@{cc}.proxy.2captcha.com:2334
#
# You do NOT need a Chinese exit. Every route this repo reads answered
# normally from a Finnish datacenter address, and the routes that refuse
# (Weibo's search, /ajax/statuses/mymblog, all of m.weibo.cn) want a
# logged-in ACCOUNT — they refuse a Beijing address just as politely. A proxy
# buys volume from many addresses here, not access.
#
# The credential never reaches a command line: it is read from this file and
# passed through the driver's own authentication fields. The Selenium engine
# is the exception and says so — it strips credentials with a warning,
# because Chromium's `--proxy-server` cannot carry them.
WEIBO_PROXY=http://{user}:{password}@ap.proxy.2captcha.com:2334


# --- A default target ------------------------------------------------------
# Used when no --url is given, for `--mode user` and `--mode post`. An
# account: https://weibo.com/u/2803301701 — or a post:
# https://weibo.com/2803301701/RiPCAfklU
#
# `--mode hot` takes no URL at all.
WEIBO_URL=
